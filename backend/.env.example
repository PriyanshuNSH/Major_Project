# =============================================================================
# HealthSync AI — Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the backend service:
# cp .env.example .env

# Server & Application Environment
ENVIRONMENT=development
APP_NAME=HealthSync AI Backend
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Future Database & Auth Placeholders (For Phase 3 - Not used in Phase 2)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthsync_dev
# JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_256_bit_string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
